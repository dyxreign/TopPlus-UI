    local ic = Instance.new("ImageLabel", btn)
    ic.Size = UDim2.new(0, 18, 0, 18)
    ic.AnchorPoint = Vector2.new(0.5, 0.5)
    ic.Position = UDim2.new(0.5, 0, 0.5, 0)
    ic.BackgroundTransparency = 1
    ic.Image = self.Lucide[config.Icon] or ""
    ic.ImageColor3 = Color3.fromRGB(255,255,255)
    ic.ZIndex = 8
    
    btn.MouseButton1Click:Connect(function() self:ToggleWindow(mascara) end)

    -- Objeto da Janela (Métodos expostos)
    local WindowElements = {}

    function WindowElements:AddToggle(opt)
        local card = Instance.new("Frame", container)
        card.Size = UDim2.new(0, opt.Width or 340, 0, opt.Height or 50)
        card.BackgroundColor3 = Color3.fromRGB(22, 22, 25)
        card.ZIndex = 12
        Instance.new("UICorner", card).CornerRadius = UDim.new(0, 8)
        Instance.new("UIStroke", card).Color = Color3.fromRGB(45, 45, 50)

        local lblTitulo = Instance.new("TextLabel", card)
        lblTitulo.Size = UDim2.new(1, -40, 0, 15)
        lblTitulo.Position = UDim2.new(0, 10, 0, 6)
        lblTitulo.BackgroundTransparency = 1
        lblTitulo.Text = opt.Title
        lblTitulo.TextColor3 = Color3.fromRGB(255, 255, 255)
        lblTitulo.FontFace = UILib.Font
        lblTitulo.TextSize = 14
        lblTitulo.TextXAlignment = Enum.TextXAlignment.Left
        lblTitulo.ZIndex = 13

        local btnToggle = Instance.new("TextButton", card)
        btnToggle.Size = UDim2.new(0, 28, 0, 16)
        btnToggle.AnchorPoint = Vector2.new(1, 1)
        btnToggle.Position = UDim2.new(1, -8, 1, -8)
        btnToggle.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
        btnToggle.Text = ""
        btnToggle.ZIndex = 14
        Instance.new("UICorner", btnToggle).CornerRadius = UDim.new(1, 0)
        
        local circle = Instance.new("Frame", btnToggle)
        circle.Size = UDim2.new(0, 12, 0, 12)
        circle.AnchorPoint = Vector2.new(0, 0.5)
        circle.Position = UDim2.new(0, 2, 0.5, 0)
        circle.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
        circle.ZIndex = 15
        Instance.new("UICorner", circle).CornerRadius = UDim.new(1, 0)

        local state = opt.Default or false
        local function updateVisual()
            TweenService:Create(btnToggle, TweenInfo.new(0.2), {BackgroundColor3 = state and Color3.fromRGB(70, 200, 70) or Color3.fromRGB(40, 40, 45)}):Play()
            TweenService:Create(circle, TweenInfo.new(0.2), {Position = state and UDim2.new(1, -14, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)}):Play()
        end
        updateVisual()

        btnToggle.MouseButton1Click:Connect(function()
            state = not state
            updateVisual()
            if opt.Callback then opt.Callback(state) end
        end)
        
        -- Retorna os métodos para atualizar externamente
        return {
            Set = function(v) state = v; updateVisual() end,
            Get = function() return state end
        }
    end

