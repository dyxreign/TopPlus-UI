-- Inicializa a UI Base (Dock e Fundo)
function UILib:Init(config)
    config = config or {}
    local uiName = config.Name or "ExploitToolbar"
    
    local LocalPlayer = Players.LocalPlayer
    local guiParent = (type(gethui) == "function" and gethui()) or (pcall(function() return game:GetService("CoreGui") end) and game:GetService("CoreGui")) or LocalPlayer:WaitForChild("PlayerGui")

    if guiParent:FindFirstChild(uiName) then
        guiParent[uiName]:Destroy()
    end

    self.ScreenGui = Instance.new("ScreenGui")
    self.ScreenGui.Name = uiName
    self.ScreenGui.IgnoreGuiInset = true 
    self.ScreenGui.ResetOnSpawn = false
    self.ScreenGui.Parent = guiParent

    self.Escurecer = Instance.new("Frame", self.ScreenGui)
    self.Escurecer.Size = UDim2.new(1, 0, 1, 0)
    self.Escurecer.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    self.Escurecer.BackgroundTransparency = 1 
    self.Escurecer.BorderSizePixel = 0
    self.Escurecer.ZIndex = 1

    -- Toolbar (Dock)
    self.Toolbar = Instance.new("Frame", self.ScreenGui)
    self.Toolbar.Size = UDim2.new(0, 210, 0, 45)
    self.Toolbar.AnchorPoint = Vector2.new(0.5, 1)
    self.Toolbar.Position = UDim2.new(0.5, 0, 1, 60)
    self.Toolbar.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    self.Toolbar.ZIndex = 5
    Instance.new("UICorner", self.Toolbar).CornerRadius = UDim.new(0, 12)
    Instance.new("UIStroke", self.Toolbar).Color = Color3.fromRGB(45, 45, 45)

    self.DockContainer = Instance.new("Frame", self.Toolbar)
    self.DockContainer.Size = UDim2.new(1, 0, 1, 0)
    self.DockContainer.BackgroundTransparency = 1
    self.DockContainer.ZIndex = 6
    
    local dockLayout = Instance.new("UIListLayout", self.DockContainer)
    dockLayout.FillDirection = Enum.FillDirection.Horizontal
    dockLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    dockLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    dockLayout.Padding = UDim.new(0, 8)
    dockLayout.SortOrder = Enum.SortOrder.LayoutOrder

    -- Botão de Toggle da Toolbar
    self.BtnToggleBar = Instance.new("ImageButton", self.Toolbar)
    self.BtnToggleBar.Size = UDim2.new(0, 24, 0, 24)
    self.BtnToggleBar.AnchorPoint = Vector2.new(0.5, 1)
    self.BtnToggleBar.Position = UDim2.new(0.5, 0, 0, -6)
    self.BtnToggleBar.BackgroundTransparency = 1
    self.BtnToggleBar.Image = self.Lucide["chevron-down"]
    self.BtnToggleBar.ImageColor3 = Color3.fromRGB(180, 180, 180)
    self.BtnToggleBar.ZIndex = 6

    self.BtnToggleBar.MouseButton1Click:Connect(function()
        self.BarraOn = not self.BarraOn
        self.BtnToggleBar.Image = self.BarraOn and self.Lucide["chevron-down"] or self.Lucide["chevron-up"]
        TweenService:Create(self.Toolbar, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Position = self.BarraOn and UDim2.new(0.5, 0, 1, -20) or UDim2.new(0.5, 0, 1, 60)
        }):Play()
        if not self.BarraOn and self.JanelaAberta then self:ToggleWindow(self.JanelaAberta) end
    end)

    task.wait(0.5)
    TweenService:Create(self.Toolbar, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(0.5, 0, 1, -20)}):Play()
end

