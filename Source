-- Lógica Interna de Alternar Janelas
function UILib:ToggleWindow(mascara)
    local anim = TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    if self.JanelaAberta == mascara then
        TweenService:Create(self.Escurecer, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
        local tw = TweenService:Create(mascara, anim, {Size = UDim2.new(0, 0, 0, 0)})
        tw:Play()
        tw.Completed:Connect(function() mascara.Visible = false end)
        self.JanelaAberta = nil
    else
        if self.JanelaAberta then 
            self.JanelaAberta.Visible = false
            self.JanelaAberta.Size = UDim2.new(0, 0, 0, 0) 
        end
        mascara.Visible = true
        self.JanelaAberta = mascara
        TweenService:Create(self.Escurecer, TweenInfo.new(0.3), {BackgroundTransparency = 0.5}):Play()
        local alturaReal = mascara:GetChildren()[1].Size.Y.Offset
        TweenService:Create(mascara, anim, {Size = UDim2.new(0, 380, 0, alturaReal)}):Play()
    end
end

