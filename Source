local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local CoreGui = (type(gethui) == "function" and gethui()) or (pcall(function() return game:GetService("CoreGui") end) and game:GetService("CoreGui")) or Players.LocalPlayer:WaitForChild("PlayerGui")

local TopPlusUi = {}
TopPlusUi.__index = TopPlusUi

local FONT_PATH = "rbxasset://fonts/families/AccanthisADFStd.json"
local FontUI = Font.new(FONT_PATH, Enum.FontWeight.Bold, Enum.FontStyle.Normal)

local successIcons, Lucide = pcall(function()
    return loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/Icons/refs/heads/main/lucide/dist/Icons.lua"))()
end)
local Icons = (successIcons and type(Lucide) == "table") and Lucide or setmetatable({}, {__index = function() return "" end})

-- Variáveis Globais de Estado da UI
local Initialized = false
local ScreenGui, Escurecer, Toolbar, MainContent, DockContainer, InfoContainer, ExpandBtn
local JanelaAberta = nil
local BarraOn = true
local IsExpanded = false
local LayoutOrderCount = 0
local WindowConfig = {}
local AllTabs = {} -- Nova tabela para controlar as cores das abas

-- Sistema de Highlight das Abas (Arruma o Bug do Gradiente)
local function UpdateTabVisuals(activeBtn)
    for _, tab in ipairs(AllTabs) do
        if tab.Button == activeBtn then
            -- Aba Ativa: Aplica a cor customizada
            if typeof(tab.Color) == "ColorSequence" then
                tab.Gradient.Color = tab.Color
            else
                local c = typeof(tab.Color) == "Color3" and tab.Color or Color3.fromRGB(255, 255, 255)
                local darker = Color3.new(c.R * 0.3, c.G * 0.3, c.B * 0.3)
                tab.Gradient.Color = ColorSequence.new(darker, c)
            end
        else
            -- Aba Inativa: Fica escura
            tab.Gradient.Color = ColorSequence.new(Color3.fromRGB(20, 20, 20), Color3.fromRGB(60, 60, 60))
        end
    end
end

local function UpdateToolbarWidth()
    if not Toolbar or not DockContainer or not InfoContainer then return end
    
    local dockWidth = DockContainer.Size.X.Offset
    local infoWidth = IsExpanded and 110 or 0
    local padding = IsExpanded and 8 or 0 
    
    local totalWidth = dockWidth + padding + infoWidth + 16

    if IsExpanded then
        InfoContainer.Visible = true
    end

    TweenService:Create(Toolbar, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, totalWidth, 0, 45)
    }):Play()

    local tw = TweenService:Create(InfoContainer, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, infoWidth, 1, 0)
    })
    tw:Play()
    
    if not IsExpanded then
        tw.Completed:Connect(function()
            if not IsExpanded then InfoContainer.Visible = false end
        end)
    end
end

local function ToggleWindow(alvo, btnReferencia)
    local anim = TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    if JanelaAberta == alvo then
        -- Fechando a UI
        TweenService:Create(Escurecer, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
        local tw = TweenService:Create(alvo, anim, {Size = UDim2.new(0, 0, 0, 0)})
        tw:Play()
        tw.Completed:Connect(function() alvo.Visible = false end)
        JanelaAberta = nil
        UpdateTabVisuals(nil) -- Apaga todas as abas
    else
        -- Abrindo uma nova UI
        if JanelaAberta then 
            JanelaAberta.Visible = false
            JanelaAberta.Size = UDim2.new(0, 0, 0, 0) 
        end
        alvo.Visible = true
        JanelaAberta = alvo
        TweenService:Create(Escurecer, TweenInfo.new(0.3), {BackgroundTransparency = WindowConfig.Transparent and 0.4 or 0.6}):Play()
        local alturaReal = alvo:GetChildren()[1].Size.Y.Offset
        TweenService:Create(alvo, anim, {Size = UDim2.new(0, 380, 0, alturaReal)}):Play()
        UpdateTabVisuals(btnReferencia) -- Acende a aba certa
    end
end

