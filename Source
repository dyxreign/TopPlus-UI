    tipo = tipo or "info"
    duracao = duracao or 4
    local cores = {
        info = {icone = "rbxassetid://7300474341", cor = Color3.fromRGB(100, 180, 255)},
        success = {icone = "rbxassetid://7300477546", cor = Color3.fromRGB(80, 220, 100)},
        warning = {icone = "rbxassetid://7300475140", cor = Color3.fromRGB(255, 180, 50)}
