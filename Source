local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local CoreGui = (type(gethui) == "function" and gethui()) or (pcall(function() return game:GetService("CoreGui") end) and game:GetService("CoreGui")) or Players.LocalPlayer:WaitForChild("PlayerGui")

local TopPlusUi = {}
TopPlusUi.__index = TopPlusUi

-- Fontes e Ícones
local FONT_PATH = "rbxasset://fonts/families/AccanthisADFStd.json"
local FontUI = Font.new(FONT_PATH, Enum.FontWeight.Bold, Enum.FontStyle.Normal)

local successIcons, Lucide = pcall(function()
    return loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/Icons/refs/heads/main/lucide/dist/Icons.lua"))()
end)
local Icons = (successIcons and type(Lucide) == "table") and Lucide or setmetatable({}, {__index = function() return "" end})

-- Variáveis Globais de Estado da UI
local Initialized = false
local ScreenGui, Escurecer, Toolbar, DockContainer
local JanelaAberta = nil
local BarraOn = true
local LayoutOrderCount = 0

local function ToggleWindow(alvo)
    local anim = TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    if JanelaAberta == alvo then
        TweenService:Create(Escurecer, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
        local tw = TweenService:Create(alvo, anim, {Size = UDim2.new(0, 0, 0, 0)})
        tw:Play()
        tw.Completed:Connect(function() alvo.Visible = false end)
        JanelaAberta = nil
    else
        if JanelaAberta then 
            JanelaAberta.Visible = false
            JanelaAberta.Size = UDim2.new(0, 0, 0, 0) 
        end
        alvo.Visible = true
        JanelaAberta = alvo
        TweenService:Create(Escurecer, TweenInfo.new(0.3), {BackgroundTransparency = 0.5}):Play()
        local alturaReal = alvo:GetChildren()[1].Size.Y.Offset
        TweenService:Create(alvo, anim, {Size = UDim2.new(0, 380, 0, alturaReal)}):Play()
    end
end

-- Inicializa a Base da UI (Dock) apenas 1 vez
local function InitBase()
    if Initialized then return end
    Initialized = true

    if CoreGui:FindFirstChild("TopPlusUI") then
        CoreGui.TopPlusUI:Destroy()
    end

    ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "TopPlusUI"
    ScreenGui.IgnoreGuiInset = true 
    ScreenGui.ResetOnSpawn = false
    ScreenGui.Parent = CoreGui

    Escurecer = Instance.new("Frame", ScreenGui)
    Escurecer.Size = UDim2.new(1, 0, 1, 0)
    Escurecer.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    Escurecer.BackgroundTransparency = 1 
    Escurecer.BorderSizePixel = 0
    Escurecer.ZIndex = 1

    Toolbar = Instance.new("Frame", ScreenGui)
    Toolbar.Size = UDim2.new(0, 50, 0, 45)
    Toolbar.AnchorPoint = Vector2.new(0.5, 1)
    Toolbar.Position = UDim2.new(0.5, 0, 1, -20)
    Toolbar.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    Toolbar.ZIndex = 5
    Toolbar.ClipsDescendants = false -- Precisa ser false para a seta aparecer fora da barra
    Instance.new("UICorner", Toolbar).CornerRadius = UDim.new(0, 12)
    Instance.new("UIStroke", Toolbar).Color = Color3.fromRGB(45, 45, 45)

    DockContainer = Instance.new("Frame", Toolbar)
    DockContainer.Size = UDim2.new(1, 0, 1, 0)
    DockContainer.BackgroundTransparency = 1
    
    local dockLayout = Instance.new("UIListLayout", DockContainer)
    dockLayout.FillDirection = Enum.FillDirection.Horizontal
    dockLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    dockLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    dockLayout.Padding = UDim.new(0, 8)
    dockLayout.SortOrder = Enum.SortOrder.LayoutOrder

    -- Botão da Seta (Toggle Bar)
    local BtnToggleBar = Instance.new("ImageButton", Toolbar)
    BtnToggleBar.Size = UDim2.new(0, 24, 0, 24)
    BtnToggleBar.AnchorPoint = Vector2.new(0.5, 1)
    BtnToggleBar.Position = UDim2.new(0.5, 0, 0, -6)
    BtnToggleBar.BackgroundTransparency = 1
    BtnToggleBar.Image = Icons["chevron-down"] or ""
    BtnToggleBar.ImageColor3 = Color3.fromRGB(180, 180, 180)
    BtnToggleBar.ZIndex = 6

    BtnToggleBar.MouseButton1Click:Connect(function()
        BarraOn = not BarraOn
        BtnToggleBar.Image = BarraOn and Icons["chevron-down"] or Icons["chevron-up"]
        TweenService:Create(Toolbar, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Position = BarraOn and UDim2.new(0.5, 0, 1, -20) or UDim2.new(0.5, 0, 1, 60)
        }):Play()
        if not BarraOn and JanelaAberta then 
            ToggleWindow(JanelaAberta) 
        end
    end)
end

-- ==============================================
-- CLASSE TAB (Janelas)
-- ==============================================
local TabClass = {}
TabClass.__index = TabClass

function TopPlusUi:Tab(options)
    InitBase()
    LayoutOrderCount = LayoutOrderCount + 1

    local titulo = options.Title or "Tab"
    local icone = options.Icon or "layout-grid"
    local alturaJanela = options.Height or 350 -- Aqui define a altura personalizada, ou 350 se não colocar nada

    -- Cria o Botão na Dock
    local btn = Instance.new("TextButton", DockContainer)
    btn.Size = UDim2.new(0, 32, 0, 32)
    btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    btn.Text = ""
    btn.LayoutOrder = LayoutOrderCount
    btn.ZIndex = 7
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    
    Toolbar.Size = UDim2.new(0, (LayoutOrderCount * 40) + 16, 0, 45)

    local grad = Instance.new("UIGradient", btn)
    grad.Rotation = 45
    grad.Color = LayoutOrderCount == 1 and ColorSequence.new(Color3.fromRGB(12,12,12), Color3.fromRGB(240,240,240)) or ColorSequence.new(Color3.fromRGB(30,30,30), Color3.fromRGB(80,80,80))
    
    local ic = Instance.new("ImageLabel", btn)
    ic.Size = UDim2.new(0, 18, 0, 18)
    ic.AnchorPoint = Vector2.new(0.5, 0.5)
    ic.Position = UDim2.new(0.5, 0, 0.5, 0)
    ic.BackgroundTransparency = 1
    ic.Image = Icons[icone] or ""
    ic.ImageColor3 = Color3.fromRGB(255,255,255)
    ic.ZIndex = 8

    -- Cria a Janela Física
    local mascara = Instance.new("Frame", ScreenGui)
    mascara.AnchorPoint = Vector2.new(0.5, 1)
    mascara.Position = UDim2.new(0.5, 0, 1, -72)
    mascara.Size = UDim2.new(0, 0, 0, 0)
    mascara.BackgroundTransparency = 1
    mascara.ClipsDescendants = true
    mascara.Visible = false
    mascara.ZIndex = 10
    
    local frame = Instance.new("Frame", mascara)
    frame.AnchorPoint = Vector2.new(0.5, 1)
    frame.Position = UDim2.new(0.5, 0, 1, 0)
    frame.Size = UDim2.new(0, 380, 0, alturaJanela) -- Usando a altura personalizada
    frame.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
    frame.ZIndex = 10
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 12)
    Instance.new("UIStroke", frame).Color = Color3.fromRGB(50, 50, 50)
    
    local tl = Instance.new("TextLabel", frame)
    tl.Size = UDim2.new(1, 0, 0, 45)
    tl.BackgroundTransparency = 1
    tl.Text = titulo
    tl.TextColor3 = Color3.fromRGB(255, 255, 255)
    tl.FontFace = FontUI
    tl.TextSize = 22
    tl.ZIndex = 11

    local container = Instance.new("ScrollingFrame", frame)
    container.Size = UDim2.new(1, 0, 1, -50)
    container.Position = UDim2.new(0, 0, 0, 45)
    container.BackgroundTransparency = 1
    container.ScrollBarThickness = 0
    container.ZIndex = 11
    
    local layout = Instance.new("UIListLayout", container)
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 8)
    Instance.new("UIPadding", container).PaddingTop = UDim.new(0, 5)

    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        container.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 20)
    end)

    btn.MouseButton1Click:Connect(function() ToggleWindow(mascara) end)

    local TabData = {
        Container = container,
        ItemCount = 0
    }
    setmetatable(TabData, TabClass)
    return TabData
end

-- ==============================================
-- COMPONENTES DA TAB (Button & Toggle)
-- ==============================================

function TabClass:Button(options)
    self.ItemCount = self.ItemCount + 1

    local card = Instance.new("TextButton", self.Container)
    card.Size = UDim2.new(0, 340, 0, 55)
    card.BackgroundColor3 = Color3.fromRGB(22, 22, 25)
    card.Text = ""
    card.AutoButtonColor = false
    card.LayoutOrder = self.ItemCount
    card.ZIndex = 12
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 8)
    local stroke = Instance.new("UIStroke", card)
    stroke.Color = Color3.fromRGB(45, 45, 50)

    local lblTitulo = Instance.new("TextLabel", card)
    lblTitulo.Size = UDim2.new(1, -20, 0, 18)
    lblTitulo.Position = UDim2.new(0, 10, 0, 8)
    lblTitulo.BackgroundTransparency = 1
    lblTitulo.Text = options.Title or "Button"
    lblTitulo.TextColor3 = Color3.fromRGB(255, 255, 255)
    lblTitulo.FontFace = FontUI
    lblTitulo.TextSize = 14
    lblTitulo.TextXAlignment = Enum.TextXAlignment.Left
    lblTitulo.ZIndex = 13

    local lblDesc = Instance.new("TextLabel", card)
    lblDesc.Size = UDim2.new(1, -20, 0, 16)
    lblDesc.Position = UDim2.new(0, 10, 0, 28)
    lblDesc.BackgroundTransparency = 1
    lblDesc.Text = options.Desc or ""
    lblDesc.TextColor3 = Color3.fromRGB(140, 140, 140)
    lblDesc.FontFace = FontUI
    lblDesc.TextSize = 12
    lblDesc.TextXAlignment = Enum.TextXAlignment.Left
    lblDesc.ZIndex = 13

    local ic = Instance.new("ImageLabel", card)
    ic.Size = UDim2.new(0, 16, 0, 16)
    ic.AnchorPoint = Vector2.new(1, 0.5)
    ic.Position = UDim2.new(1, -10, 0.5, 0)
    ic.BackgroundTransparency = 1
    ic.Image = Icons["mouse-pointer-click"]
    ic.ImageColor3 = Color3.fromRGB(180, 180, 180)
    ic.ZIndex = 13

    card.MouseEnter:Connect(function() TweenService:Create(stroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(80, 80, 85)}):Play() end)
    card.MouseLeave:Connect(function() TweenService:Create(stroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(45, 45, 50)}):Play() end)
    
    card.MouseButton1Click:Connect(function()
        local tw = TweenService:Create(card, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(35, 35, 40)})
        tw:Play()
        tw.Completed:Connect(function()
            TweenService:Create(card, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(22, 22, 25)}):Play()
        end)

        if options.Callback then
            task.spawn(options.Callback)
        end
    end)
end

function TabClass:Toggle(options)
    self.ItemCount = self.ItemCount + 1
    local state = options.Value or false

    local card = Instance.new("TextButton", self.Container)
    card.Size = UDim2.new(0, 340, 0, 60)
    card.BackgroundColor3 = Color3.fromRGB(22, 22, 25)
    card.Text = ""
    card.AutoButtonColor = false
    card.LayoutOrder = self.ItemCount
    card.ZIndex = 12
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 8)
    Instance.new("UIStroke", card).Color = Color3.fromRGB(45, 45, 50)

    local textOffset = options.Icon and 35 or 10

    if options.Icon then
        local ic = Instance.new("ImageLabel", card)
        ic.Size = UDim2.new(0, 18, 0, 18)
        ic.Position = UDim2.new(0, 10, 0, 10)
        ic.BackgroundTransparency = 1
        ic.Image = Icons[options.Icon] or ""
        ic.ImageColor3 = Color3.fromRGB(200, 200, 200)
        ic.ZIndex = 13
    end

    local lblTitulo = Instance.new("TextLabel", card)
    lblTitulo.Size = UDim2.new(1, -(textOffset + 50), 0, 16)
    lblTitulo.Position = UDim2.new(0, textOffset, 0, 10)
    lblTitulo.BackgroundTransparency = 1
    lblTitulo.Text = options.Title or "Toggle"
    lblTitulo.TextColor3 = Color3.fromRGB(255, 255, 255)
    lblTitulo.FontFace = FontUI
    lblTitulo.TextSize = 14
    lblTitulo.TextXAlignment = Enum.TextXAlignment.Left
    lblTitulo.ZIndex = 13

    local lblDesc = Instance.new("TextLabel", card)
    lblDesc.Size = UDim2.new(1, -20, 0, 28)
    lblDesc.Position = UDim2.new(0, 10, 0, 28)
    lblDesc.BackgroundTransparency = 1
    lblDesc.Text = options.Desc or ""
    lblDesc.TextColor3 = Color3.fromRGB(140, 140, 140)
    lblDesc.FontFace = FontUI
    lblDesc.TextSize = 11
    lblDesc.TextWrapped = true
    lblDesc.TextXAlignment = Enum.TextXAlignment.Left
    lblDesc.TextYAlignment = Enum.TextYAlignment.Top
    lblDesc.ZIndex = 13

    local switchBg = Instance.new("Frame", card)
    switchBg.Size = UDim2.new(0, 32, 0, 18)
    switchBg.AnchorPoint = Vector2.new(1, 0.5)
    switchBg.Position = UDim2.new(1, -10, 0.5, 0)
    switchBg.BackgroundColor3 = state and Color3.fromRGB(70, 200, 70) or Color3.fromRGB(40, 40, 45)
    switchBg.ZIndex = 14
    Instance.new("UICorner", switchBg).CornerRadius = UDim.new(1, 0)
    
    local circle = Instance.new("Frame", switchBg)
    circle.Size = UDim2.new(0, 14, 0, 14)
    circle.AnchorPoint = Vector2.new(0, 0.5)
    circle.Position = state and UDim2.new(1, -16, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
    circle.BackgroundColor3 = Color3.fromRGB(220, 220, 220)
    circle.ZIndex = 15
    Instance.new("UICorner", circle).CornerRadius = UDim.new(1, 0)

    local function updateVisual()
        TweenService:Create(switchBg, TweenInfo.new(0.2), {BackgroundColor3 = state and Color3.fromRGB(70, 200, 70) or Color3.fromRGB(40, 40, 45)}):Play()
        TweenService:Create(circle, TweenInfo.new(0.2), {Position = state and UDim2.new(1, -16, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)}):Play()
    end

    card.MouseButton1Click:Connect(function()
        state = not state
        updateVisual()
        if options.Callback then
            task.spawn(options.Callback, state)
        end
    end)

    return {
        Set = function(v) state = v; updateVisual() end,
        Get = function() return state end
    }
end

return TopPlusUi
